{
  "name": "portfolio-ledger",
  "version": "0.1.0",
  "description": "Local, offline desktop app to track investment accounts across institutions.",
  "author": "Raviraj",
  "main": "src/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win nsis",
    "sample": "node scripts/generate-sample-excel.js"
  },
  "build": {
    "appId": "com.portfolioledger.app",
    "productName": "Portfolio Ledger",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "nodemailer": "^10.0.10",
    "xlsx": "^0.18.5"
  }
}
